# Copy to .env to override defaults. Every value has a safe local default, so `docker compose up`
# works without a .env file. Replace ALL secrets before any non-local use.
POSTGRES_PASSWORD=postgres
INGEST_DB_PASSWORD=ingest-local-password
BILLING_DB_PASSWORD=billing-local-password
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
INTERNAL_TOKEN=change-me-in-production
VITE_API_BASE_URL=http://localhost:8001
# Finance-wide dashboard token (cross-account). Enter it in the dashboard's "Connect" box.
DASHBOARD_TOKEN=demo-dashboard-token
# Optional per-account tokens, JSON map account_id -> token (a customer token cannot read another account).
ACCOUNT_DASHBOARD_TOKENS={"00000000-0000-0000-0000-000000000001":"replace-demo-account-token"}
EVENTS_PER_SECOND=4
RATE_LIMIT_PER_MINUTE=600
# Events loaded by the one-shot seed service (0 disables it).
SEED_EVENTS=500000
